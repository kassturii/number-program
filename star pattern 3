#include <stdio.h>

int main() {
    int i,temp,j,row;
    
    printf("Enter the number of rows :");
    scanf ("%d",&row);
    for ( int i=1;i<=row;i++){
        
       for(j=1;j<=i;j++){
        printf("*");
       }
       printf("\n");
      }
      for ( int i=row-1;i>=1;i--){
       
       for(j=1;j<=i;j++){
        printf("*");
       }
       printf("\n");
    }
    return 0;
}
