#include <stdio.h>

int main() {
    int i,j,count ;
    // Write C code here
    printf("NO. PRIME NUMBER ARE \n");
    for (i=1;i<=50;i++)
        {
            if (i %2!=0){
                count =0;
                for (j=1;j<=i;j++){
                    if(i%j==0)
                        count ++;
                }
                if (count>2)
                    printf("  ,%d",i);
            }
        }

    return 0;
}
