#include <stdio.h>

int main() {
    int size = 5;
    float sales[size];

    // Input loop
    for (int i = 0; i < size; i++) {
        printf("Enter the sales for salesman %d: ", i + 1);
        scanf("%f", &sales[i]);
    }

    printf("\n--- Sales Summary ---\n");

    // Output loop
    for (int i = 0; i < size; i++) {
        printf("sales[%d] = %.2f\n", i + 1, sales[i]);
    }

    return 0;
}
