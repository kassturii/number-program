#include <stdio.h>

int main() {
    int n = 4;
    int i, j;

    // Outer loop controls the rows (counts down from n to 1)
    for (i = n; i >= 1; i--) {
        
        // Inner loop prints 'i' stars for the current row
        for (j = 1; j <= i; j++) {
            printf("* ");
        }
        
        // Move to the next line after finishing the row
        printf("\n");
    }

    return 0;
}
