#include <stdio.h>

int main() {
    // Write C code here
    int n,num ,sum=0,i=1;
    float average ;
    printf("Enter the number of AVERAGE:");
    scanf("%d",&n);
    while(i<=n)
    {
        printf("Enter the number :");
        scanf("%d",&num);
        sum=sum+num;
        i++;
    }
    average=(float)sum/n;
    printf("Average=%f",average);
    
    return 0;
}
