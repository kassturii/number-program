#include <stdio.h>

int main() {
    int x;
    printf("Enter the number to check: ");
    scanf("%d", &x);

    if (x > 0) {
        printf("%d is a positive number.\n", x);
    } else if (x < 0) {
        printf("%d is a negative number.\n", x);
    } else {
        printf("The number is zero.\n");
    }

    return 0;
}
