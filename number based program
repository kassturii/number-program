#include <stdio.h>

int main() {
    int i, j, n;
    int k = 1; // Initialize k so it does not print garbage values

    printf("Enter the number of rows: ");
    scanf("%d", &n);

    for (i = 1; i <= n; i++) {
        for (j = 1; j <= i; j++) {
            printf("%d ", k);
            k++;
        }
        printf("\n");
    }

    return 0; // Moved outside the outer loop
}
