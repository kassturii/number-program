#include <stdio.h>

int main() {
    int n, power = 1;

    printf("Enter a decimal number: ");
    scanf("%d", &n);

    if (n == 0) {
        printf("Binary equivalent: 0\n");
        return 0;
    }

    // Step 1: Find the largest power of 2
    while (power * 2 <= n) {
        power = power * 2;
    }

    printf("Binary equivalent of %d is: ", n);

    // Step 2: Check each bit and print
    while (power > 0) {
        if (n >= power) {
            printf("1");
            n = n - power;
        } else {
            printf("0");
        }
        power = power / 2;
    }

    printf("\n");
    return 0;
}
