#include <stdio.h>

int main() {
    int i, n;
    float sum = 0;

    printf("Enter the number n: ");
    scanf("%d", &n);

    for (i = 1; i <= n; i++) {
        if (i % 2 != 0) {
            sum = sum + (float) i / (i * (i + 1));
        }
    }

    printf("The sum of the number is %f\n", sum);

    return 0;
