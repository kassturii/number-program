#include <stdio.h>

int main() {
    int i,temp,j,row;
    
    printf("Enter the number of rows :");
    scanf ("%d",&row);
    for ( int i=1;i<=row;i++){
        for(temp=1;temp<=row-i;temp++){
            printf(" ");
        }
       for(j=1;j<=2*i-1;j++){
        printf("*");
       }
       printf("\n");
      }
      for ( int i=row;i>=1;i--){
        for(temp=1;temp<=row-i;temp++){
            printf(" ");
        }
       for(j=1;j<=2*i-1;j++){
        printf("*");
       }
       printf("\n");
    }
    return 0;
}
